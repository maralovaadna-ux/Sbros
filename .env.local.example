NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только для сервера, НИКОГДА не должен попадать в браузер / git.
# Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Любая длинная случайная строка. Используется для входа по телефону без SMS.
# Сгенерировать можно так: openssl rand -hex 32
AUTH_PHONE_SECRET=your-random-secret-string
